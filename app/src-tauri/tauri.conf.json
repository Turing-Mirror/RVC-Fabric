{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RVC Fabric",
  "version": "1.3.2",
  "identifier": "com.turingmirror.rvcfabric",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Turing-Mirror",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../frontend": "frontend"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cnb.cool/Turing-Mirror/RVC-Fabric-Releases/-/git/raw/main/updater.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1MzNGQ0Y0Qjk1OTBEMkMKUldRc0RWbTU5UHd6MVhJTmVYQ0V3NldHN1krdW8wcjNjZzJQRGQ1ZU1kL01jbmNTQWVxQkk5OGUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
